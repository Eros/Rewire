<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Rewire.ViewModels"
        x:Class="Rewire.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/rewire.ico"
        Title="Rewire"
        Width="1320" Height="900" MinWidth="960" MinHeight="680">

    <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0" Margin="12,4,12,0">
        <TabItem Header="Configure">
            <ContentControl Content="{Binding Configurator}" />
        </TabItem>
        <TabItem Header="Train">
            <ContentControl Content="{Binding Trainer}" />
        </TabItem>
    </TabControl>
</Window>
