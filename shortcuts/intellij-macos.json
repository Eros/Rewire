{
  "name": "IntelliJ IDEA",
  "platform": "macos",
  "shortcuts": [
    { "action": "Go to declaration", "keys": "cmd+b" },
    { "action": "Find usages", "keys": "alt+f7" },
    { "action": "Rename", "keys": "shift+f6" },
    { "action": "Reformat code", "keys": "cmd+alt+l" },
    { "action": "Find action", "keys": "cmd+shift+a" },
    { "action": "Recent files", "keys": "cmd+e" },
    { "action": "Run", "keys": "ctrl+r" },
    { "action": "Debug", "keys": "ctrl+d" },
    { "action": "Comment line", "keys": "cmd+/" },
    { "action": "Duplicate line", "keys": "cmd+d" },
    { "action": "Delete line", "keys": "cmd+bspace" },
    { "action": "Move line up", "keys": "alt+shift+up" },
    { "action": "Move line down", "keys": "alt+shift+down" },
    { "action": "Extend selection", "keys": "alt+up" },
    { "action": "Go to class", "keys": "cmd+o" },
    { "action": "Go to file", "keys": "cmd+shift+o" },
    { "action": "Go to symbol", "keys": "cmd+alt+o" },
