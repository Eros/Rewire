    { "action": "Go to implementation", "keys": "cmd+alt+b" },
    { "action": "File structure", "keys": "cmd+f12" },
    { "action": "Extract variable", "keys": "cmd+alt+v" },
    { "action": "Extract method", "keys": "cmd+alt+m" },
