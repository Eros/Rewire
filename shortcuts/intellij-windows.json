{
  "name": "IntelliJ IDEA",
  "platform": "windows",
  "shortcuts": [
    { "action": "Go to declaration", "keys": "ctrl+b" },
    { "action": "Find usages", "keys": "alt+f7" },
    { "action": "Rename", "keys": "shift+f6" },
    { "action": "Reformat code", "keys": "ctrl+alt+l" },
    { "action": "Find action", "keys": "ctrl+shift+a" },
    { "action": "Recent files", "keys": "ctrl+e" },
    { "action": "Run", "keys": "shift+f10" },
    { "action": "Debug", "keys": "shift+f9" },
    { "action": "Comment line", "keys": "ctrl+/" },
    { "action": "Duplicate line", "keys": "ctrl+d" },
    { "action": "Delete line", "keys": "ctrl+y" },
    { "action": "Move line up", "keys": "alt+shift+up" },
    { "action": "Move line down", "keys": "alt+shift+down" },
    { "action": "Extend selection", "keys": "ctrl+w" },
    { "action": "Go to class", "keys": "ctrl+n" },
    { "action": "Go to file", "keys": "ctrl+shift+n" },
    { "action": "Go to symbol", "keys": "ctrl+alt+shift+n" },
