    { "action": "Go to implementation", "keys": "ctrl+alt+b" },
    { "action": "File structure", "keys": "ctrl+f12" },
    { "action": "Extract variable", "keys": "ctrl+alt+v" },
    { "action": "Extract method", "keys": "ctrl+alt+m" },
    { "action": "Find in files", "keys": "ctrl+shift+f" },
    { "action": "Replace", "keys": "ctrl+r" }
  ]
}
